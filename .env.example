# --- Telegram ---
# Получи токен у @BotFather: https://t.me/BotFather → /newbot
# НИКОГДА не коммить .env с реальным токеном в репозиторий!
TELEGRAM_BOT_TOKEN=12345:replace_me_with_token_from_botfather

# --- Hyperliquid ---
# "mainnet" (реальные деньги/реальные позиции) или "testnet" (для разработки)
HL_NETWORK=mainnet

# --- Watcher ---
# Интервал опроса позиций по REST, в секундах. Минимум 5.
WATCHER_POLL_INTERVAL_SECONDS=10

# Порог для уведомления об изменении размера позиции (срабатывает, если оба условия выполнены).
# Изменение в процентах
ALERT_PCT_THRESHOLD=5.0
# Изменение в USD-нотионале
ALERT_USD_THRESHOLD=5000

# --- Bot policy ---
# Максимум кошельков на одного пользователя
MAX_WALLETS_PER_USER=10

# Если задано — бот работает в режиме приватного (whitelist по chat_id), список через запятую.
# Если пусто — бот публичный.
# WHITELIST_CHAT_IDS=123456789,987654321
WHITELIST_CHAT_IDS=

# --- Storage ---
DATABASE_PATH=data/whale_bot.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
